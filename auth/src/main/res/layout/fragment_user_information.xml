<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="16dp">

            <!-- OrderShield Brand Header (same as info screen) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/ordershield_brand"
                    android:src="@drawable/ic_shield_outline" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ordershield_brand"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verification_protection"
                        android:textColor="@color/gray_light"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Header: User Information Verification -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="User Information Verification"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/user_information_subtitle"
                android:textColor="@color/gray_light"
                android:textSize="14sp"
                android:layout_marginBottom="32dp" />

            <!-- First Name Field -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/first_name_label"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/black_stroke_state_list"
                    app:boxStrokeWidth="1dp"
                    android:textColorHint="@color/gray_light"
                    app:hintTextColor="@color/gray_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Person icon inside input -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/black"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/first_name_label"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- Last Name Field -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/last_name_label"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/black_stroke_state_list"
                    app:boxStrokeWidth="1dp"
                    android:textColorHint="@color/gray_light"
                    app:hintTextColor="@color/gray_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLastName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Person icon inside input -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/black"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/last_name_label"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- Date of Birth Field -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_of_birth_label"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/black_stroke_state_list"
                    app:boxStrokeWidth="1dp"
                    android:textColorHint="@color/gray_light"
                    app:hintTextColor="@color/gray_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="48dp"
                        android:paddingEnd="16dp"
                        android:inputType="date"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Calendar icon inside input -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/black"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/date_of_birth_label"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- Continue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="@string/continue_text"
                android:textColor="@color/gray_light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/gray_lighter"
                android:enabled="false"
                app:cornerRadius="12dp" />

            <!-- Spacer to push footer to bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Section (same as info screen) - Anchored to Bottom -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="@color/white">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/gray_lighter" />

        <!-- Footer: Secured By OrderShield -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verification_info_footer2"
                android:textColor="@color/gray_light"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOrderShieldLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ordershield_brand"
                android:textColor="@color/icon_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer Text 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/verification_info_footer3"
            android:textColor="@color/gray_light"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
